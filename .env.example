# Copy to .env and fill in. One .env per deployment (one business).
POSTGRES_PASSWORD=
# Generate each secret with: python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=
JWT_SECRET_KEY=

# What kind of business is this deployment? retail | restaurant | bar
BUSINESS_TYPE=retail
BUSINESS_NAME=My Store
CURRENCY=USD
TAX_RATE=0.0825
TIMEZONE=America/Mexico_City

# Lock to your frontend URL in production, comma separated
CORS_ORIGINS=*

# First Admin, created on first start only if the database has no users (password 8+ chars,
# must be changed at first login). Remove these after the first start.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
