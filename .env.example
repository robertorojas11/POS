# Copy to .env and fill in. One .env per deployment (one business).
POSTGRES_PASSWORD=change-me
SECRET_KEY=generate-with-python--c-"import secrets;print(secrets.token_hex(32))"
JWT_SECRET_KEY=generate-another-one

# What kind of business is this deployment? retail | restaurant | bar
BUSINESS_TYPE=retail
BUSINESS_NAME=My Store
CURRENCY=USD
TAX_RATE=0.0825
TIMEZONE=America/Mexico_City

# Lock to your frontend URL in production, comma separated
CORS_ORIGINS=*
